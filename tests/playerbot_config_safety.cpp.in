struct ItemTemplate
{
    uint32 id = 1, quality = ITEM_QUALITY_NORMAL, level = 10, required = 10, sell = 100, buy = 0, stack = 20;
    uint32 GetId() const { return id; }
    uint32 GetQuality() const { return quality; }
    uint32 GetItemLevel() const { return level; }
    uint32 GetBaseRequiredLevel() const { return required; }
    uint32 GetSellPrice() const { return sell; }
    uint32 GetBuyPrice() const { return buy; }
    uint32 GetMaxStackSize() const { return stack; }
    uint32 GetDuration() const { return 0; }
    char const* GetDefaultLocaleName() const { return "Iron Bar"; }
};
