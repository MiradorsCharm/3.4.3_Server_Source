};
map<uint8, vector<uint8>> RandomPlayerbotFactory::availableRaces;
@RACE_SETUP@
vector<uint8> ClassesToCreate(int count = 0)
{
    RandomPlayerbotFactory factory(3);
    bool creationFailed = false;
@CLASS_LOOP@
    CHECK(!creationFailed);
    return factory.created;
}
