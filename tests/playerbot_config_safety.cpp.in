void TestListsAndReads()
{
    string maps = " 0,1,530,571,0 ";
    vector<uint32> ids{ 99 };
    LoadRandomBotMaps(maps, ids);
    CHECK(ids == vector<uint32>({ 0, 1, 530, 571 }));
    CHECK(maps == "0,1,530,571");
    maps = " 0, 33,999,70000,1), -1,4294967296,1e3,0x1,1junk,1, 530 ";
    LoadRandomBotMaps(maps, ids);
    CHECK(ids == vector<uint32>({ 0, 1, 530 }) && maps == "0,1,530");
    maps = "-1,invalid,33,4294967296";
    LoadRandomBotMaps(maps, ids);
    CHECK(ids.empty() && maps.empty());
    LoadList("0,12, 4294967295 ,12,1.5", ids, "test");
    CHECK(ids == vector<uint32>({ 0, 12, numeric_limits<uint32>::max() }));
    LoadList("", ids, "test");
    CHECK(ids.empty());

    playerbotConfig.Initialize();
    CHECK(playerbotConfig.randomBotMapsAsString == "0,1,530,571");
    CHECK(playerbotConfig.randomBotUpdateInterval == 60);
    configMgr.negativeInts = true;
    playerbotConfig.Initialize();
    CHECK(playerbotConfig.randomBotUpdateInterval == 60);
    CHECK(playerbotConfig.minRandomBots == 0 && playerbotConfig.maxRandomBots == 0);
    CHECK(playerbotConfig.randomBotAccountCount == 0 && playerbotConfig.randomBotGuildCount == 0);
    CHECK(playerbotConfig.globalCoolDown == 0 && playerbotConfig.minGuildTaskRewardTime == 0);
    CHECK(playerbotConfig.specProbability[1][0] == 0);
    configMgr.negativeInts = false;
    configMgr.ints["AiPlayerbot.RandomBotUpdateInterval"] = numeric_limits<int32>::max();
    playerbotConfig.Initialize();
    CHECK(playerbotConfig.randomBotUpdateInterval == 60);
    configMgr.ints["AiPlayerbot.MinRandomBots"] = 80;
    configMgr.ints["AiPlayerbot.MaxRandomBots"] = 20;
    playerbotConfig.Initialize();
    CHECK(playerbotConfig.minRandomBots == 20 && playerbotConfig.maxRandomBots == 80);
    configMgr = ConfigMgr{};
}
void TestAccountConfiguration()
{
    for (string prefix : { "", "rnd%", "rnd'bot", "rnd=bot", "rnd bot" })
    {
        configMgr.strings["AiPlayerbot.RandomBotAccountPrefix"] = prefix;
        CHECK(!playerbotConfig.Initialize() && !playerbotConfig.enabled);
    }
    configMgr.strings["AiPlayerbot.RandomBotAccountPrefix"] = "rnd_bot";
    CHECK(playerbotConfig.Initialize());
    CHECK(RandomBotAccountPattern("rnd_bot") == "rnd=_bot%");
    CHECK(RandomBotAccountPattern("rndbot") == "rndbot%");
    configMgr = ConfigMgr{};
    RandomPlayerbotFactory first(1);
    auto races = first.availableRaces;
    RandomPlayerbotFactory second(2);
    CHECK(second.availableRaces == races);
    CHECK(ClassesToCreate() == vector<uint8>({ 1, 2, 3, 4, 5, 7, 8, 9, 11 }));
    CHECK(ClassesToCreate(9) == vector<uint8>({ 1 }));
    CHECK(ClassesToCreate(10).empty());
}
void TestRandomRanges()
{
    for (float multiplier : { 0.0f, -1.0f, numeric_limits<float>::quiet_NaN(), numeric_limits<float>::infinity() })
    {
        configMgr.floats["AiPlayerbot.RandomChangeMultiplier"] = multiplier;
        playerbotConfig.Initialize();
        CHECK(playerbotConfig.randomChangeMultiplier == 1.0f);
        CHECK(playerbotConfig.GetRandomChangeRange(10) == 11);
    }
    for (float multiplier : { 1.0e-38f, 1.0e38f, 1.0f })
    {
        playerbotConfig.randomChangeMultiplier = multiplier;
        uint32 range = playerbotConfig.GetRandomChangeRange(10);
        CHECK(range >= 1);
        if (multiplier < 1) CHECK(range == numeric_limits<uint32>::max());
        if (multiplier > 1) CHECK(range == 1);
        RandomTrigger trigger{ numeric_limits<int32>::max() };
        CHECK(trigger.IsActive()); // RNG stub returns the lower bound; no overflow/modulo-zero
    }
    CHECK(playerbotConfig.GetRandomChangeRange(-100) == 1);
    CHECK(playerbotConfig.GetRandomChangeRange(numeric_limits<double>::quiet_NaN()) == 1);
    configMgr = ConfigMgr{};
}
void TestPricesAndStock()
{
    ItemTemplate proto;
    for (float multiplier : { 0.0f, -1.0f, numeric_limits<float>::quiet_NaN(), numeric_limits<float>::infinity() })
    {
        configMgr.floats["AhBot.PriceMultiplier"] = multiplier;
        configMgr.floats["AhBot.PriceQualityMultiplier"] = multiplier;
        ahbotConfig.Initialize();
        CHECK(ahbotConfig.priceMultiplier == 1.0f && ahbotConfig.priceQualityMultiplier == 1.0f);
    }
    configMgr = ConfigMgr{};
    ahbotConfig.Initialize();
    CHECK(auctionbot.GetSellPrice(&proto) == 100 && auctionbot.GetBuyPrice(&proto) == 150);
    CHECK(auctionbot.GetSellPrice(nullptr) == 0 && auctionbot.GetBuyPrice(nullptr) == 0);
    CHECK(ClampBotPrice(numeric_limits<double>::quiet_NaN()) == 0);
    CHECK(ClampBotPrice(numeric_limits<double>::infinity()) == numeric_limits<int32>::max());
    proto.sell = numeric_limits<uint32>::max();
    CHECK(auctionbot.GetSellPrice(&proto) == numeric_limits<int32>::max());
    CHECK(auctionbot.GetBuyPrice(&proto) == numeric_limits<int32>::max());
    proto.sell = 0;
    proto.level = 100000;
    CHECK(auctionbot.GetSellPrice(&proto) > 0); // no signed level*level overflow
    ahbotConfig.priceMultiplier = 1.0e38f;
    CHECK(auctionbot.GetSellPrice(&proto) == numeric_limits<int32>::max());
    proto = ItemTemplate{};
    for (float rarity : { 0.0f, 1.0e-38f, -1.0f, numeric_limits<float>::quiet_NaN(), 1.0f })
    {
        ahbotConfig.priceQualityMultiplier = rarity;
        double multiplier = auctionbot.GetRarityPriceMultiplier(&proto);
        CHECK(isfinite(multiplier) && multiplier > 0.0);
        stock.clear();
        SelectedTradeStock(&proto);
        CHECK(stock.size() <= 7);
    }
    configMgr.negativeInts = true;
    ahbotConfig.Initialize();
    CHECK(ahbotConfig.defaultMinPrice == 0 && ahbotConfig.maxItemLevel == 0 && ahbotConfig.maxRequiredLevel == 0);
    configMgr.negativeInts = false;
    configMgr.strings["AhBot.IgnoreItems"] = "1,2";
    ahbotConfig.Initialize();
    CHECK(ahbotConfig.ignoreItemIds == set<uint32>({ 1, 2 }));
    configMgr.strings.clear();
    ahbotConfig.Initialize();
    CHECK(ahbotConfig.ignoreItemIds.empty());
}
void TestItemLimits()
{
    objectMgr.items = { { 1, {} }, { 2, {} } };
    objectMgr.items.at(2).id = 2;
    objectMgr.items.at(2).level = objectMgr.items.at(2).required = 100;
    ahbotConfig.Initialize();
    RandomItemMgr mgr;
    CHECK(mgr.Query(RANDOM_ITEM_GUILD_TASK) == RandomItemList({ 1, 2 }));
    ahbotConfig.maxItemLevel = 20;
    CHECK(mgr.Query(RANDOM_ITEM_GUILD_TASK) == RandomItemList({ 1 }));
    ahbotConfig.maxItemLevel = 0;
    ahbotConfig.maxRequiredLevel = 20;
    CHECK(mgr.Query(RANDOM_ITEM_GUILD_TASK) == RandomItemList({ 1 }));
    ahbotConfig.maxRequiredLevel = 0;
    ahbotConfig.ignoreItemIds.insert(1);
    CHECK(mgr.Query(RANDOM_ITEM_GUILD_TASK) == RandomItemList({ 2 }));
}
void TestSpellDependencies()
{
    SpellRequiredMap requirements;
    SpellMgr ranks;
    CHECK(WouldCreateSpellRequirementCycle(requirements, 1, 1, ranks));
    CHECK(!WouldCreateSpellRequirementCycle(requirements, 1, 2, ranks));
    requirements.emplace(1, 2);
    CHECK(WouldCreateSpellRequirementCycle(requirements, 2, 1, ranks));
    requirements.emplace(2, 3);
    CHECK(WouldCreateSpellRequirementCycle(requirements, 3, 1, ranks));
    CHECK(!WouldCreateSpellRequirementCycle(requirements, 4, 2, ranks));
    requirements.emplace(4, 2); // legitimate shared prerequisite
    requirements.emplace(5, 6);
    requirements.emplace(6, 5); // tolerate an already broken component without looping
    CHECK(!WouldCreateSpellRequirementCycle(requirements, 7, 5, ranks));
    requirements.clear();
    ranks.previous = { { 11, 10 } }; // spell 11 is a higher rank of spell 10
    requirements.emplace(10, 20);
    CHECK(WouldCreateSpellRequirementCycle(requirements, 20, 11, ranks));
    requirements.clear();
    requirements.emplace(20, 10);
    CHECK(!WouldCreateSpellRequirementCycle(requirements, 11, 20, ranks)); // valid cross-rank progression
    ranks.previous.clear();
    requirements.clear();
    for (uint32 id = 1; id < 20000; ++id) requirements.emplace(id, id + 1);
    CHECK(WouldCreateSpellRequirementCycle(requirements, 20000, 1, ranks));
    CHECK(!WouldCreateSpellRequirementCycle(requirements, 20001, 1, ranks));
}
int main()
{
    try
    {
        TestListsAndReads(); TestAccountConfiguration(); TestRandomRanges(); TestPricesAndStock(); TestItemLimits(); TestSpellDependencies();
        cout << "Config/pricing/dependency regressions passed\n";
    }
    catch (exception const& error) { cerr << error.what() << '\n'; return 1; }
}
