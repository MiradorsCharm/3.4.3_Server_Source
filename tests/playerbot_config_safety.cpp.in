#define CHECK(...) do { if (!(__VA_ARGS__)) throw runtime_error("Check failed at line " + to_string(__LINE__) + ": " #__VA_ARGS__); } while (false)
int warnings = 0;
template<typename... T> void Warn(T const&...) { ++warnings; }
template<typename... T> void Log(T const&...) { }
#define TC_LOG_ERROR(...) Warn(__VA_ARGS__)
#define TC_LOG_WARN(...) Warn(__VA_ARGS__)
#define TC_LOG_INFO(...) Log(__VA_ARGS__)
#define TC_LOG_DEBUG(...) Log(__VA_ARGS__)
uint32 urand(uint32 lo, uint32 hi) { CHECK(lo <= hi); return lo; }
struct ConfigMgr
{
    map<string, int> ints;
    map<string, float> floats;
    map<string, string> strings;
    bool negativeInts = false;
    bool GetBoolDefault(string const&, bool def) const { return def; }
    int GetIntDefault(string const& key, int def) const
    {
        if (negativeInts) return -1;
        auto it = ints.find(key);
        return it == ints.end() ? def : it->second;
    }
    float GetFloatDefault(string const& key, float def) const
    {
        auto it = floats.find(key);
        return it == floats.end() ? def : it->second;
    }
    string GetStringDefault(string const& key, string const& def) const
    {
        auto it = strings.find(key);
        return it == strings.end() ? def : it->second;
    }
} configMgr;
auto sConfigMgr = &configMgr;
struct MapEntry { bool instance = false; bool Instanceable() const { return instance; } };
struct MapStore
{
    map<uint32, MapEntry> maps{ { 0, {} }, { 1, {} }, { 530, {} }, { 571, {} }, { 33, { true } }, { 70000, {} } };
    MapEntry const* LookupEntry(uint32 id) const { auto it = maps.find(id); return it == maps.end() ? nullptr : &it->second; }
} sMapStore;
