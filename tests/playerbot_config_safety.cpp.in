using ItemTemplateContainer = map<uint32, ItemTemplate>;
struct ObjectMgr { ItemTemplateContainer items; auto const& GetItemTemplateStore() const { return items; } } objectMgr;
auto sObjectMgr = &objectMgr;
char const* strstri(char const* text, char const* search) { return strstr(text, search); }
enum RandomItemType { RANDOM_ITEM_GUILD_TASK };
using RandomItemList = vector<uint32>;
struct RandomItemPredicate { virtual bool Apply(ItemTemplate const*) = 0; virtual ~RandomItemPredicate() = default; };
struct RandomItemMgr
{
    map<RandomItemType, RandomItemPredicate*> predicates;
    RandomItemList Query(RandomItemType type);
};
@RANDOM_ITEMS@
using SpellRequiredMap = multimap<uint32, uint32>;
struct SpellMgr
{
    map<uint32, uint32> previous;
    uint32 GetPrevSpellInChain(uint32 id) const
    {
        auto it = previous.find(id);
        return it == previous.end() ? 0 : it->second;
    }
};
